%% paper-review 最终架构；每个命名组件都对应仓库中的模块。
flowchart TB
    Browser["浏览器 / Vue 3 SPA"] -->|"经 Vite proxy 访问 /api"| API["FastAPI API 层\nbackend/app/api"]
    API --> Auth["认证 / 权限\nbackend/app/auth"]
    API --> Graph["LangGraph 评审 Graph\n解析 → 确认 → 检索 → 评分"]
    Graph --> Specialists["专项 Agents\nevidence / topic_fit / coherence"]
    Specialists --> Review["review_agent"]
    Review --> Verifier["verifier_agent\n保留 / 降级 / 证据不足 / 拒绝"]
    Graph --> Rules["确定性规则\n一致性 / 引用 / 聚合"]
    Review --> Tools["本地 StructuredTools\nbackend/app/agent/tools.py"]
    Tools --> Retrieve["RAG 检索\n3 条路由 + 回退 + 可选 Rerank"]
    Retrieve --> Chroma[("Chroma\n子向量")]
    Retrieve --> MySQL[("MySQL\n父文档 / rubric / 评审 / 聊天 / trace")]
    Tools --> Rules
    Review --> LLM["OpenAI-compatible HTTP\nchat + tool calling"]
    Retrieve --> Embed["Embedding HTTP"]
    Retrieve --> Rerank["可选 Rerank HTTP"]
    LLM --> Model[("已配置的模型服务")]
    Embed --> ModelE[("已配置的 embedding 服务")]
    Rerank --> ModelR[("已配置的 Rerank 服务")]
    API --> Chat["记录级 AI 聊天"]
    Chat --> MySQL
    API --> Obs["JSON 日志 / metrics / AgentStep"]
    Graph --> Obs
