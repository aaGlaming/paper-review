  "cards": [
    {
      "dot": "cyan",
      "title": "Boundary",
      "items": [
        "Core path is a single FastAPI process with LangGraph and local tools",
        "/api/chat is a separate record-level inquiry path"
      ]
    },
    {
      "dot": "amber",
      "title": "External dependencies",
      "items": [
        "MySQL is durable business state; Chroma is local persistent vector state",
        "Model, embedding and rerank provider values come from runtime configuration"
      ]
    },
    {
      "dot": "rose",
      "title": "Evidence rule",
      "items": [
        "Parent text remains in MySQL so submitted quotes can be checked as continuous substrings"
      ]
    }
