{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "预审主路径",
    "subtitle": "一条主路径；模型调用在信任边界外",
    "locale": "zh-CN",
    "output": "docs/diagrams/review.workflow.html",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "intake", "label": "接入与确认" },
    { "id": "evidence", "label": "取证与打分" },
    { "id": "outside", "label": "信任边界外 · 外部依赖", "variant": "exception" },
    { "id": "output", "label": "校验与产物" }
  ],
  "mainPath": ["upload", "confirm", "align", "retrieve", "select", "check", "verify", "changes"],
  "nodes": [
    { "id": "upload", "lane": "intake", "col": 0, "type": "frontend", "label": "上传论文", "sublabel": "Markdown 文本入参" },
    { "id": "confirm", "lane": "intake", "col": 1, "type": "security", "label": "确认章节", "sublabel": "人工确认章节树", "tag": "未确认不评分" },
    { "id": "align", "lane": "intake", "col": 2, "type": "backend", "label": "对齐赛题", "sublabel": "取该题约束与量规" },
    { "id": "retrieve", "lane": "evidence", "col": 2, "type": "backend", "label": "逐维检索", "sublabel": "过滤子块 → 取父块" },
    { "id": "select", "lane": "evidence", "col": 3, "type": "backend", "label": "选档", "sublabel": "五维档位与原句" },
    { "id": "check", "lane": "evidence", "col": 4, "type": "backend", "label": "规则审查", "sublabel": "数字 · 引用 · 越界" },
    { "id": "model", "lane": "outside", "col": 3, "type": "external", "label": "模型兼容接口", "sublabel": "HTTPS · 对话与嵌入", "tag": "外部依赖" },
    { "id": "verify", "lane": "output", "col": 4, "type": "backend", "label": "子串校验", "sublabel": "原句须是切片子串" },
    { "id": "changes", "lane": "output", "col": 5, "type": "backend", "label": "修改清单", "sublabel": "每条指回上游结果" }
  ],
  "edges": [
    { "id": "upload-confirm", "from": "upload", "to": "confirm", "role": "main" },
    { "id": "confirm-align", "from": "confirm", "to": "align", "role": "main" },
    { "id": "align-retrieve", "from": "align", "to": "retrieve", "role": "main" },
    { "id": "retrieve-select", "from": "retrieve", "to": "select", "label": "候选父块", "role": "main" },
    { "id": "select-check", "from": "select", "to": "check", "label": "档位", "role": "main" },
    { "id": "check-verify", "from": "check", "to": "verify", "role": "main" },
    { "id": "verify-changes", "from": "verify", "to": "changes", "label": "通过校验", "role": "main" },
    { "id": "retrieve-model", "from": "retrieve", "to": "model", "label": "embed()" },
    { "id": "select-model", "from": "select", "to": "model", "label": "chat()" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "主路径只有一条",
      "items": [
        "上传 → 确认章节 → 对齐赛题 → 逐维检索 → 选档 → 规则审查 → 子串校验 → 修改清单",
        "未确认章节树不进入评分：图停在确认节点",
        "检查点按 review_id 保存，重启后从暂停点继续"
      ]
    },
    {
      "dot": "rose",
      "title": "信任边界与外部依赖",
      "items": [
        "全项目只有模型客户端发 HTTP，只使用 httpx",
        "模型兼容接口在信任边界外：检索走 embed()，选档走 chat()",
        "密钥只从环境变量读，不打印、不回显、不落盘"
      ]
    },
    {
      "dot": "emerald",
      "title": "校验与产物",
      "items": [
        "引用必须是切片的连续子串，对不上写「引用失败」",
        "证据不足不换算成分数，不参与加权",
        "输出限于档位、论文原句与修改清单"
      ]
    }
  ]
}
