{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "父子块数据流",
    "subtitle": "子块进 Chroma，父块留在 MySQL，送入模型的是父块",
    "locale": "zh-CN",
    "output": "docs/diagrams/chunks.dataflow.html",
    "quality_profile": "showcase"
  },
  "stages": [
    { "label": "论文输入" },
    { "label": "切块" },
    { "label": "两处落库" },
    { "label": "过滤与召回" },
    { "label": "送入模型" }
  ],
  "nodes": [
    { "id": "paper", "type": "frontend", "label": "论文纯文本", "sublabel": "Markdown 字符串", "stage": 0, "row": 1 },
    { "id": "splitter", "type": "backend", "label": "切块", "sublabel": "标题分段 → 片段", "tag": "表格单独成块", "stage": 1, "row": 1 },
    { "id": "parent_block", "type": "backend", "label": "父块（章节全文）", "sublabel": "带 char_span", "stage": 1, "row": 2 },
    { "id": "chroma", "type": "database", "label": "Chroma", "sublabel": "子块片段 + 元数据 + 向量", "tag": "子块只进这里", "stage": 2, "row": 0 },
    { "id": "mysql", "type": "database", "label": "MySQL paper_parent", "sublabel": "父块全文 · char_span", "tag": "父块全文留在这里", "stage": 2, "row": 2 },
    { "id": "filter", "type": "backend", "label": "过滤与召回", "sublabel": "contest_id / rubric_id / section_type", "tag": "先过滤再排序", "stage": 3, "row": 0 },
    { "id": "parent_fetch", "type": "backend", "label": "取回父块全文", "sublabel": "按 parent_id · 每维最多 4 段", "stage": 3, "row": 1 },
    { "id": "model", "type": "cloud", "label": "模型兼容接口", "sublabel": "选档 chat()", "tag": "信任边界外", "stage": 4, "row": 1 }
  ],
  "flows": [
    { "id": "paper-to-splitter", "from": "paper", "to": "splitter", "label": "论文纯文本", "classification": "只读入参", "variant": "emphasis" },
    { "id": "splitter-to-chroma", "from": "splitter", "to": "chroma", "label": "子块片段与向量", "classification": "片段 + 元数据", "variant": "emphasis" },
    { "id": "splitter-to-parent", "from": "splitter", "to": "parent_block", "label": "父块全文", "classification": "章节整段", "variant": "default" },
    { "id": "parent-to-mysql", "from": "parent_block", "to": "mysql", "label": "全文落库", "classification": "save_parents()", "variant": "emphasis" },
    { "id": "chroma-to-filter", "from": "chroma", "to": "filter", "label": "候选子块", "classification": "元数据里带 parent_id", "variant": "default" },
    { "id": "mysql-to-parent-fetch", "from": "mysql", "to": "parent_fetch", "label": "父块全文", "classification": "按 parent_id", "variant": "emphasis" },
    { "id": "filter-to-parent-fetch", "from": "filter", "to": "parent_fetch", "label": "命中的 parent_id", "classification": "过滤后的候选", "variant": "default" },
    { "id": "parent-fetch-to-model", "from": "parent_fetch", "to": "model", "label": "父块全文", "classification": "每维最多 4 段", "variant": "security" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "两条路分开",
      "items": [
        "子块片段、元数据与向量进 Chroma，父块全文不进向量库",
        "父块全文只落在 MySQL 的 paper_parent，按 parent_id 取回",
        "送入模型的是父块全文，不是子块碎片"
      ]
    },
    {
      "dot": "amber",
      "title": "过滤与顺序",
      "items": [
        "过滤条件：contest_id、rubric_id、section_type $in",
        "过滤先于任何排序与截断；重排属 P4，只改顺序",
        "section_type 是单值字符串：数组元数据用 $in 会静默返回空"
      ]
    },
    {
      "dot": "rose",
      "title": "边界与范围",
      "items": [
        "模型接口在信任边界外，是选档那一步才出的界",
        "本版不调用 chat() 与 embed()，向量由调用方显式传入",
        "doc_type 只有五个：paper_child、band_text、pitfall、exemplar、contest_statement"
      ]
    }
  ]
}
