{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "父子块数据流",
    "subtitle": "子块进 Chroma，父块留在 MySQL；送进模型的是父块全文（v1.9.3）",
    "locale": "zh-CN",
    "output": "docs/diagrams/chunks.dataflow.html",
    "quality_profile": "showcase"
  },
  "stages": [
    { "label": "论文输入" },
    { "label": "切块" },
    { "label": "两处落库" },
    { "label": "过滤与召回" },
    { "label": "送入模型" }
  ],
  "nodes": [
    { "id": "paper", "type": "frontend", "label": "论文纯文本", "sublabel": "Markdown 字符串", "stage": 0, "row": 1 },
    { "id": "splitter", "type": "backend", "label": "切块", "sublabel": "按空行成块 → 片段", "tag": "表格单独成块", "stage": 1, "row": 1 },
    { "id": "parent_block", "type": "backend", "label": "父块（章节全文）", "sublabel": "带 char_span", "stage": 1, "row": 2 },
    { "id": "chroma", "type": "database", "label": "Chroma", "sublabel": "片段 + 八键元数据 + 向量", "tag": "子块只进这里", "stage": 2, "row": 0 },
    { "id": "mysql", "type": "database", "label": "MySQL paper_parent", "sublabel": "父块全文 · char_span", "tag": "父块全文留在这里", "stage": 2, "row": 2 },
    { "id": "filter", "type": "backend", "label": "过滤与召回", "sublabel": "四键过滤", "tag": "先过滤再排序", "stage": 3, "row": 0 },
    { "id": "parent_fetch", "type": "backend", "label": "取回父块全文", "sublabel": "按 parent_id · 合并后取 4 段", "stage": 3, "row": 1 },
    { "id": "model", "type": "cloud", "label": "模型兼容接口", "sublabel": "选档 chat()", "tag": "信任边界外", "stage": 4, "row": 1 }
  ],
  "flows": [
    { "id": "paper-to-splitter", "from": "paper", "to": "splitter", "label": "论文纯文本", "classification": "只读入参", "variant": "emphasis" },
    { "id": "splitter-to-chroma", "from": "splitter", "to": "chroma", "label": "片段与向量", "classification": "embed() 生成向量", "variant": "emphasis" },
    { "id": "splitter-to-parent", "from": "splitter", "to": "parent_block", "label": "父块全文", "classification": "章节整段", "variant": "default" },
    { "id": "parent-to-mysql", "from": "parent_block", "to": "mysql", "label": "全文落库", "classification": "save_parents()", "variant": "emphasis" },
    { "id": "chroma-to-filter", "from": "chroma", "to": "filter", "label": "候选子块", "classification": "元数据带 parent_id", "variant": "default" },
    { "id": "mysql-to-parent-fetch", "from": "mysql", "to": "parent_fetch", "label": "父块全文", "classification": "按 parent_id", "variant": "emphasis" },
    { "id": "filter-to-parent-fetch", "from": "filter", "to": "parent_fetch", "label": "命中的 parent_id", "classification": "三路合并去重", "variant": "default" },
    { "id": "parent-fetch-to-model", "from": "parent_fetch", "to": "model", "label": "父块全文", "classification": "每维至多 4 段", "variant": "security" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "两条路分开",
      "items": [
        "子块片段、八键元数据与向量进 Chroma；父块全文不进向量库",
        "父块全文只落在 MySQL 的 paper_parent，按 parent_id 取回",
        "送入模型的是父块全文，不是子块碎片；命中的 chunk_ids 随父块带回，供溯源"
      ]
    },
    {
      "dot": "amber",
      "title": "切块与顺序",
      "items": [
        "按空行成块，相邻段可并到 200 字；两行以上带竖线的表格单独成块，不切进相邻段落",
        "每块带 char_start / char_end，保证 text[char_start:char_end] 等于块文本",
        "过滤先于排序与截断：三路各召回 6 条 → 按 parent_id 合并 → 一次重排 → 取前 4 段"
      ]
    },
    {
      "dot": "rose",
      "title": "边界与现状",
      "items": [
        "向量由调用方显式传给模块，模块内的占位 EF 一旦被调用就报错，避免 Chroma 下载默认模型",
        "embed() 在确认章节后建索引时真实调用；RERANK_* 配齐才启用重排，缺失则直接跳过",
        "doc_type 只有五个：paper_child、band_text、pitfall、exemplar、contest_statement；section_type 必须单值"
      ]
    }
  ]
}
